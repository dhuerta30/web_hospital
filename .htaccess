# =============================================================================
#  .htaccess raíz — Sitio institucional HSJM
#  Fuerza HTTPS, aplica cabeceras y bloquea archivos sensibles.
#  Conserva el enrutado de ArtifyRouter. NO toca la intranet interna.
# =============================================================================
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS (idempotente si cPanel ya redirige)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Enrutado original de ArtifyRouter (sin cambios)
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains" "expr=%{HTTPS} == 'on'"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(sql|sqlite|db|dump|bak|old|orig|save|swp|tmp|log|inc|ini|sh|bash)$">
        Require all denied
    </FilesMatch>
    <Files "error_log">
        Require all denied
    </Files>
    <FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json|arco|\.gitignore|\.gitattributes)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(yml|yaml|dist|md|lock|phps)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "(~|#)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteRule ^(app/libs/artify/uploads|app/libs/artify/downloads|app/libs/docufy/downloads|data1)/.*\.(php[0-9]?|phtml?|phtm|phar|pht|phps|cgi|pl|py|sh|exe)$ - [F,L,NC]
</IfModule>