<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /web_hospital/

    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<Files ".env">
    Require all denied
</Files>